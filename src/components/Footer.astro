---
const GITHUB_URL = 'https://github.com/rbcodelabs/geode';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div>
      <a class="site-footer-brand" href="/">
        <span class="site-footer-crystal" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="17" height="17" fill="none"><path d="M16 4 25 11l-3.5 16h-11L7 11l9-7Z" fill="currentColor"/><path d="m16 4 9 7-3.5 16L16 16V4Z" fill="#294835" fill-opacity=".2"/></svg>
        </span>
        Geode
