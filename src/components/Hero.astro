---
import GeodeWorkspacePreview from './GeodeWorkspacePreview.astro';

const GITHUB_URL = 'https://github.com/rbcodelabs/geode';
const VERSION = '0.13.0';
---

<section class="landing-hero" aria-labelledby="landing-title">
  <div class="landing-eyebrow"><span class="landing-dot" aria-hidden="true"></span>Your notes. Plain Markdown. Fully yours.</div>
  <h1 id="landing-title">A place for ideas<br />to stay <em>connected.</em></h1>
  <p class="landing-lead">
    Geode is an open-source, local-first Markdown knowledge base. Open any folder as a vault, write in plain files,
    and follow the links between what you know.
  </p>
  <div class="landing-actions">
    <a class="landing-btn" href="#install">Download for macOS <span aria-hidden="true">↓</span></a>
    <a class="landing-btn landing-btn-secondary" href={GITHUB_URL} target="_blank" rel="noopener noreferrer">View on GitHub <span aria-hidden="true">↗</span></a>
  </div>
  <p class="landing-hosts">Open source · MIT · v{VERSION} · iOS managed-vault MVP validated</p>

  <GeodeWorkspacePreview />

  <div class="landing-benefit-strip" aria-label="Product benefits">
    <span>▤ Plain Markdown files</span>
    <span>↗ First-class linked notes</span>
    <span>⌕ Search across your vault</span>
  </div>
</section>
