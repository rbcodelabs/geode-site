---
const ROADMAP_URL = 'https://compass.rbcodelabs.com/portal/rbcodelabs/geode/roadmap';
const FEEDBACK_URL = 'https://compass.rbcodelabs.com/portal/rbcodelabs/geode/feedback';
---

<section class="geode-roadmap-cta" aria-labelledby="roadmap-cta-title">
  <div class="geode-section-inner">
    <h2 id="roadmap-cta-title">See what's next for Geode</h2>
    <p>Follow the public roadmap, or tell us what you'd like Geode to do.</p>
    <div class="landing-actions">
      <a class="landing-btn" href={ROADMAP_URL} target="_blank" rel="noopener noreferrer">View the roadmap <span aria-hidden="true">↗</span></a>
      <a class="landing-btn landing-btn-secondary" href={FEEDBACK_URL} target="_blank" rel="noopener noreferrer">Share feedback <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
