---
// Cross-links Geode to its sibling products (Compass, Claude Threads).
// Equivalent switchers ship independently in the compass and claude-threads-site
// repos — same visual/interaction spec, no shared code between them.
---

<nav class="product-switcher" aria-label="Product family">
  <a class="product-switcher-item" href="https://compass.rbcodelabs.com">
    <svg
      class="product-switcher-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
    </svg>
    Compass
  </a>

  <span class="product-switcher-item is-current" aria-current="page">
    <svg class="product-switcher-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M16 4 25 11l-3.5 16h-11L7 11l9-7Z" fill="currentColor"></path>
      <path d="m16 4 9 7-3.5 16L16 16V4Z" fill="#294835" fill-opacity=".2"></path>
    </svg>
    Geode
  </span>

  <a class="product-switcher-item" href="https://threads.rbcodelabs.com">
    <svg class="product-switcher-icon" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path
        d="M9 12.5C9 10.567 10.567 9 12.5 9H19.5C21.433 9 23 10.567 23 12.5V17.5C23 19.433 21.433 21 19.5 21H14L10 24.5V21H12.5C10.567 21 9 19.433 9 17.5V12.5Z"
        fill="currentColor"
      ></path>
      <circle cx="13" cy="15" r="1.2" class="product-switcher-icon-dot"></circle>
      <circle cx="16" cy="15" r="1.2" class="product-switcher-icon-dot"></circle>
      <circle cx="19" cy="15" r="1.2" class="product-switcher-icon-dot"></circle>
    </svg>
    Threads
  </a>
</nav>
