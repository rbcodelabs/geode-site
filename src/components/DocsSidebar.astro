---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_ORDER, CATEGORY_LABELS } from '../lib/docsCategories';

interface Props {
  docs: CollectionEntry<'docs'>[];
  currentId: string;
}

const { docs, currentId } = Astro.props;
const currentTitle = docs.find((doc) => doc.id === currentId)?.data.title ?? 'Documentation';

const grouped = CATEGORY_ORDER.map((category) => ({
  category,
  label: CATEGORY_LABELS[category] ?? category,
  items: docs
    .filter((d) => d.data.category === category)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((group) => group.items.length > 0);
---

<aside class="docs-sidebar">
  <details class="docs-mobile-nav">
    <summary>
      <span>Browse documentation</span>
      <small>{currentTitle}</small>
    </summary>
    <nav aria-label="Documentation">
      {
        grouped.map((group) => (
          <div class="docs-nav-group">
            <h2>{group.label}</h2>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={`/docs/${item.id}/`} aria-current={item.id === currentId ? 'page' : undefined}>
                    {item.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </details>

  <nav class="docs-desktop-nav" aria-label="Documentation">
    {
      grouped.map((group) => (
        <div class="docs-nav-group">
          <h2>{group.label}</h2>
          <ul>
            {group.items.map((item) => (
              <li>
                <a href={`/docs/${item.id}/`} aria-current={item.id === currentId ? 'page' : undefined}>
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</aside>
