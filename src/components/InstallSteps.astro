---
import CodeBlock from './CodeBlock.astro';

const RELEASES_URL = 'https://github.com/rbcodelabs/geode/releases';

const installSteps = [
  {
    title: 'Download the dmg',
    description:
      'Grab Geode-<version>-arm64.dmg (Apple Silicon) or Geode-<version>.dmg (Intel) from the latest GitHub release.',
  },
  {
    title: 'Drag Geode to Applications',
    description: 'Open the dmg and drag Geode.app into your Applications folder.',
  },
  {
    title: 'Bypass Gatekeeper on first launch',
    description:
      'These builds are ad-hoc signed but not notarized, so macOS shows an "unidentified developer" warning the first time you open a downloaded copy.',
  },
];
---

<section id="install" class="geode-install" aria-labelledby="install-title">
  <div class="geode-section-inner">
    <div class="geode-section-heading">
      <div class="landing-eyebrow">Install Geode</div>
      <h2 id="install-title">Your vault is a download away.</h2>
      <p>
        Prebuilt macOS installers for Apple Silicon and Intel are published on the
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">Releases page</a>
        whenever a version tag is pushed. Windows and Linux builds aren't set up yet.
      </p>
      <p class="geode-platform-note">
        The iOS managed-vault MVP has passed native and UI automation plus physical-device validation for vault
        discovery and opening notes. It is not yet a public iOS release: Files/File Provider-backed vaults,
        community plugins, and release signing and distribution remain open production gates.
      </p>
    </div>

    <div class="geode-install-grid">
      <div>
        <h3>Install on macOS</h3>
        <ol class="geode-install-list">
          {
            installSteps.map((step, i) => (
              <li>
                <span class="geode-step-marker">{i + 1}</span>
                <div>
                  <strong>{step.title}</strong>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <h3>Opening an unsigned build</h3>
        <p class="geode-install-intro">Pick either option. Both only need to be done once per downloaded copy.</p>
        <ol class="geode-install-list">
          <li>
            <span class="geode-step-marker is-secondary">A</span>
            <div>
              <strong>Right-click to open</strong>
              <p>Right-click or Control-click Geode.app → Open → Open again. You can also use System Settings → Privacy &amp; Security → Open Anyway.</p>
            </div>
          </li>
          <li>
            <span class="geode-step-marker is-secondary">B</span>
            <div>
              <strong>Clear the quarantine flag</strong>
              <p>Run this once in Terminal, then launch normally:</p>
              <div class="geode-command"><CodeBlock code="xattr -dr com.apple.quarantine /Applications/Geode.app" /></div>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>
