---
import CodeBlock from './CodeBlock.astro';

const RELEASES_URL = 'https://github.com/rbcodelabs/geode/releases';

const installSteps = [
  {
    title: 'Download the dmg',
    description:
      'Grab Geode-<version>-arm64.dmg (Apple Silicon) or Geode-<version>.dmg (Intel) from the latest GitHub release.',
  },
  {
    title: 'Drag Geode to Applications',
    description: 'Open the dmg and drag Geode.app into your Applications folder.',
  },
  {
    title: 'Bypass Gatekeeper on first launch',
    description:
      'These builds are ad-hoc signed but not notarized, so macOS shows an "unidentified developer" warning the first time you open a downloaded copy.',
  },
];
---

<section id="install" class="border-y border-[rgb(var(--color-border))] bg-[rgb(var(--color-surface-alt))]/40">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Installation</h2>
      <p class="mt-4 text-[rgb(var(--color-text-muted))]">
        Prebuilt macOS installers (Apple Silicon + Intel) are published on the
        {' '}
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="text-[rgb(var(--color-secondary))] underline underline-offset-2 hover:text-[rgb(var(--color-primary))]">
          Releases page
        </a>
        {' '}whenever a version tag is pushed. Windows and Linux builds aren't set up yet.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-[rgb(var(--color-text-muted))]">
        The iOS managed-vault MVP has passed native and UI automation plus physical-device validation for vault
        discovery and opening notes. It is not yet a public iOS release: Files/File Provider-backed vaults,
        community plugins, and release signing and distribution remain open production gates.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div>
        <h3 class="text-lg font-bold">Steps</h3>
        <ol class="mt-6 space-y-5">
          {
            installSteps.map((step, i) => (
              <li class="flex gap-4">
                <span
                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold text-white"
                  style="background: linear-gradient(135deg, #14B8A6, #A855F7);"
                >
                  {i + 1}
                </span>
                <div class="w-full">
                  <p class="font-semibold">{step.title}</p>
                  <p class="mt-1 text-sm text-[rgb(var(--color-text-muted))]">{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div>
        <h3 class="text-lg font-bold">Opening an unsigned build</h3>
        <p class="mt-4 text-sm text-[rgb(var(--color-text-muted))]">
          Pick either option — both only need to be done once per downloaded copy:
        </p>
        <ol class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[rgb(var(--color-border))] text-sm font-bold text-[rgb(var(--color-text))]">
              A
            </span>
            <div class="w-full">
              <p class="font-semibold">Right-click to open</p>
              <p class="mt-1 text-sm text-[rgb(var(--color-text-muted))]">
                Right-click (or Control-click) Geode.app → Open → Open again in the confirmation dialog. Also
                available under System Settings → Privacy & Security → Open Anyway.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[rgb(var(--color-border))] text-sm font-bold text-[rgb(var(--color-text))]">
              B
            </span>
            <div class="w-full">
              <p class="font-semibold">Clear the quarantine flag</p>
              <p class="mt-1 text-sm text-[rgb(var(--color-text-muted))]">
                Run this once in Terminal, then launch normally:
              </p>
              <div class="mt-3">
                <CodeBlock code="xattr -dr com.apple.quarantine /Applications/Geode.app" />
              </div>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>
