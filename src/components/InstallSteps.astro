---
import CodeBlock from './CodeBlock.astro';

const RELEASES_URL = 'https://github.com/rbcodelabs/geode/releases';

const installSteps = [
  {
    title: 'Download the dmg',
    description:
      'Grab Geode-<version>-arm64.dmg (Apple Silicon) or Geode-<version>.dmg (Intel) from the latest GitHub release.',
  },
  {
    title: 'Drag Geode to Applications',
    description: 'Open the dmg and drag Geode.app into your Applications folder.',
  },
  {
    title: 'Launch it',
    description:
      'Every release is Developer ID signed, notarized, and stapled by Apple before it ships, so Geode opens normally the first time — no security prompt to click through.',
  },
];

const UPDATE_SCRIPT_URL = 'https://raw.githubusercontent.com/rbcodelabs/geode/main/scripts/geode-update.mts';
const UPDATE_COMMAND = `curl -fsSL ${UPDATE_SCRIPT_URL} -o /tmp/geode-update.mts && node /tmp/geode-update.mts`;
---

<section id="install" class="geode-install" aria-labelledby="install-title">
  <div class="geode-section-inner">
    <div class="geode-install-primary">
      <div class="geode-install-lead">
        <div class="landing-eyebrow">Install Geode</div>
        <h2 id="install-title">Your vault is a download away.</h2>
        <p>
          Prebuilt macOS installers for Apple Silicon and Intel are published whenever a version tag is pushed.
        </p>
        <a class="geode-release-link" href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          View the latest release <span aria-hidden="true">↗</span>
        </a>
        <dl class="geode-release-facts">
          <div><dt>Platform</dt><dd>macOS</dd></div>
          <div><dt>Builds</dt><dd>Apple Silicon · Intel</dd></div>
          <div><dt>Not available</dt><dd>Windows · Linux</dd></div>
        </dl>
      </div>

      <div class="geode-install-card">
        <div class="geode-install-label">Install on macOS</div>
        <ol class="geode-install-list">
          {
            installSteps.map((step, i) => (
              <li>
                <span class="geode-step-marker">{i + 1}</span>
                <div>
                  <strong>{step.title}</strong>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <aside class="geode-gatekeeper" aria-labelledby="gatekeeper-title">
      <div class="geode-gatekeeper-copy">
        <div class="geode-install-label">Prefer one command?</div>
        <h3 id="gatekeeper-title">Install or update from the Terminal.</h3>
        <p>
          This script verifies the release's Developer ID signature, stable Apple Team ID, hardened runtime, and
          stapled notarization ticket before installing — no dmg, no security prompt to click through.
        </p>
      </div>
      <div class="geode-open-options">
        <div>
          <span class="geode-option-marker">→</span>
          <div>
            <p><strong>Run it straight from GitHub</strong>No clone, no account, no auth needed:</p>
            <div class="geode-command"><CodeBlock code={UPDATE_COMMAND} /></div>
          </div>
        </div>
      </div>
    </aside>

    <p class="geode-platform-note">
      <strong>iOS status</strong> The managed-vault MVP has passed native and UI automation plus physical-device validation
      for vault discovery and opening notes. It is not yet a public iOS release: Files/File Provider-backed vaults,
      community plugins, and release signing and distribution remain open production gates.
    </p>
  </div>
</section>
