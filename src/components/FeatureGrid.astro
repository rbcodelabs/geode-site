---
// Curated from the README's "Features (v0.1)" list — the strongest,
// most concrete features for a landing page grid. Sentences trimmed from
// the README; no claims added beyond what it documents.
const features = [
  {
    title: 'Vaults',
    description: 'Open any folder as a vault. External edits are picked up live, no import step required.',
  },
  {
    title: 'Editor',
    description:
      'CodeMirror 6 with markdown highlighting, [[wikilink]] autocomplete, Cmd/Ctrl+click to follow, autosave, and rename-updates-links.',
  },
  {
    title: 'Reading view',
    description:
      'Callouts (13 types, foldable), embeds for notes/images/audio/video, highlights, tags, tables, task lists, and YAML properties.',
  },
  {
    title: 'Connected notes',
    description:
      'Backlinks pane, outline, tag pane, unresolved-link styling, and link resolution by shortest path and alias.',
  },
  {
    title: 'Search',
    description: 'tag:, path:, and file: operators, quoted phrases, negation, and regex — right in the search bar.',
  },
  {
    title: 'Workspace',
    description: 'Tabs, split panes, pinned tabs, collapsible sidebars, and a status-bar word count.',
  },
  {
    title: 'Command palette & quick switcher',
    description: 'Cmd+P for commands, Cmd+O to jump between notes, Cmd+D for daily notes.',
  },
  {
    title: 'Themes',
    description: 'Dark and light themes driven by CSS variables, matching the same theming model as the original.',
  },
];
---

<section id="features" class="geode-features">
  <div class="geode-section-inner">
    <div class="geode-feature-heading">
      <div>
        <div class="landing-eyebrow">The local-first foundation</div>
        <h2>Everything you need for a connected vault.</h2>
      </div>
      <p>
        The core loop works today: vaults, editing, wikilinks, backlinks, search, tags, and reading view.
      </p>
    </div>

    <div class="geode-feature-layout">
      <article class="geode-vault-panel">
        <div class="geode-vault-crystal" aria-hidden="true">◇</div>
        <p class="geode-panel-kicker">Your vault, on your disk</p>
        <h3>Plain files.<br /><em>Lasting ownership.</em></h3>
        <div class="geode-file-stack" aria-hidden="true">
          <div class="geode-folder"><span>◇</span> Field Notes</div>
          <div class="geode-disk-file is-active"><span>MD</span> Garden plans.md</div>
          <div class="geode-disk-file"><span>MD</span> Seed catalog.md</div>
          <div class="geode-disk-file"><span>MD</span> September journal.md</div>
        </div>
        <p class="geode-panel-note">
          Open any folder. Edit anywhere. Geode notices external changes without an import step.
        </p>
      </article>

      <div class="geode-feature-index">
        {
          features.map((feature, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
