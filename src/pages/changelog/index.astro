---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { groupByMinor, versionAnchorId } from '../../lib/changelog';

const RELEASES_URL = 'https://github.com/rbcodelabs/geode/releases';

const allEntries = await getCollection('changelog');
const sortedEntries = [...allEntries].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const groups = groupByMinor(sortedEntries);

const dateFormatter = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const title = 'Changelog — Geode';
const description = 'Every release of Geode, from the earliest tag to the latest version, with full release notes pulled from GitHub.';
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Changelog</h1>
      <p class="mt-4 text-[rgb(var(--color-text-muted))]">
        Every release of Geode, tracked here in full. For the unstyled view, see the
        {' '}
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="text-[rgb(var(--color-secondary))] underline underline-offset-2 hover:text-[rgb(var(--color-primary))]">
          raw GitHub Releases list
        </a>.
      </p>
    </div>

    <nav aria-label="Jump to version" class="mt-10 flex flex-wrap justify-center gap-2 border-y border-[rgb(var(--color-border))] py-4">
      {
        groups.map((group) => (
          <a
            href={`#${group.id}`}
            class="rounded-md px-3 py-1.5 text-sm font-medium text-[rgb(var(--color-text-muted))] transition-colors hover:bg-[rgb(var(--color-surface))] hover:text-[rgb(var(--color-text))]"
          >
            {group.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-12 space-y-16">
      {
        groups.map(async (group) => (
          <div>
            <h2 id={group.id} class="scroll-mt-24 text-2xl font-extrabold tracking-tight">
              {group.label}
            </h2>

            <div class="mt-8 space-y-12">
              {await Promise.all(
                group.entries.map(async (entry) => {
                  const { Content } = await render(entry);
                  const id = versionAnchorId(entry.data.version);
                  return (
                    <div>
                      <div id={id} class="scroll-mt-24 flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b border-[rgb(var(--color-border))] pb-3">
                        <span class="text-lg font-bold text-[rgb(var(--color-text))]">v{entry.data.version}</span>
                        <span class="text-sm text-[rgb(var(--color-text-muted))]">{dateFormatter.format(entry.data.date)}</span>
                        <a
                          href={entry.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="ml-auto text-sm text-[rgb(var(--color-secondary))] underline underline-offset-2 hover:text-[rgb(var(--color-primary))]"
                        >
                          View on GitHub
                        </a>
                      </div>
                      <div class="docs-content mt-4">
                        <div>
                          <Content />
                        </div>
                      </div>
                    </div>
                  );
                })
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
