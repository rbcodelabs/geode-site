---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_ORDER, CATEGORY_LABELS, sortDocs } from '../../lib/docsCategories';

const allDocs = sortDocs(await getCollection('docs'));

const categories = CATEGORY_ORDER.map((category) => {
  const items = allDocs.filter((d) => d.data.category === category);
  return { category, label: CATEGORY_LABELS[category] ?? category, items, first: items[0] };
}).filter((c) => c.items.length > 0);

const title = 'Documentation — Geode';
const description =
  'Geode documentation: task-oriented guides, the product roadmap, reference specifications, and architecture decisions.';
---

<Layout title={title} description={description}>
  <section class="docs-index">
    <div class="docs-index-hero">
      <div class="docs-kicker">Learn Geode</div>
      <h1>Documentation</h1>
      <p>
        Start with task-oriented guides for using Geode, then explore the implementation roadmap, reference
        specifications, plugin API surface, and architecture decisions behind the app.
      </p>
    </div>

    <div class="docs-category-grid">
      {
        categories.map((cat) => (
          <section class="docs-category-card card">
            <h2>
              <a href={`/docs/${cat.first.id}/`}>{cat.label} <span aria-hidden="true">↗</span></a>
            </h2>
            <p>{cat.first.data.description}</p>
            <ul>
              {cat.items.map((item) => (
                <li>
                  <a href={`/docs/${item.id}/`}>{item.data.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
