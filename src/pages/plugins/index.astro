---
import Layout from '../../layouts/Layout.astro';
import { supportedPluginsRegistry } from '../../lib/supportedPlugins.mjs';

const title = 'Supported plugins — Geode';
const description = 'Exact Obsidian community plugin releases tested with Geode, with compatibility details and reproducible evidence.';
const plugins = supportedPluginsRegistry.plugins;
---

<Layout title={title} description={description}>
  <section class="plugins-page">
    <div class="plugins-hero">
      <div class="docs-kicker">Compatibility catalog</div>
      <h1>Supported plugins</h1>
      <p>
        Each listing covers one exact release whose distributable files were exercised against Geode.
        Newer releases are not covered until they are tested and listed separately.
      </p>
      <p class="plugins-api-link">
        The app reads the same catalog from{' '}
        <a href="/supported-plugins/v1.json">
          /supported-plugins/v1.json
        </a>.
      </p>
    </div>

    <div class="plugins-grid">
      {
        plugins.map((plugin) => (
          <article class="plugin-card card">
            <div class="plugin-card-heading">
              <div>
                <p class="plugin-id">{plugin.id}</p>
                <h2>{plugin.name}</h2>
              </div>
              <span class="plugin-status">{plugin.status}</span>
            </div>

            <p class="plugin-description">{plugin.description}</p>

            <dl class="plugin-details">
              <div><dt>Tested release</dt><dd>{plugin.manifest.releaseTag}</dd></div>
              <div><dt>Manifest version</dt><dd>{plugin.manifest.version}</dd></div>
              <div><dt>Requires Geode</dt><dd>{plugin.minimumGeodeVersion}+</dd></div>
              <div><dt>Certified with Geode</dt><dd>{plugin.certifiedWithGeodeVersion}</dd></div>
              <div><dt>Platform</dt><dd class="plugin-platform">{plugin.platforms.join(', ')}</dd></div>
              <div><dt>Declared minimum Obsidian version</dt><dd>{plugin.manifest.minAppVersion}</dd></div>
              <div><dt>Source</dt><dd>{plugin.github.owner}/{plugin.github.repo}</dd></div>
            </dl>

            <div class="plugin-links">
              <a href={`https://github.com/${plugin.github.owner}/${plugin.github.repo}/releases/tag/${plugin.manifest.releaseTag}`} target="_blank" rel="noopener noreferrer">View exact release</a>
              <a href={plugin.evidenceUrl} target="_blank" rel="noopener noreferrer">Review compatibility evidence</a>
            </div>
          </article>
        ))
      }
    </div>

    <aside class="plugins-note">
      <h2>What “supported” means</h2>
      <p>Geode support applies only to the version, platform, and release artifacts shown here. It is not a claim that every feature or future release from the same repository will work. Artifact hashes and test evidence are published in the machine-readable catalog for reproducibility.</p>
    </aside>
  </section>
</Layout>
