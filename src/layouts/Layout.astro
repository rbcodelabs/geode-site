---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  landing?: boolean;
}

const { title, description, ogImage, landing = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultDescription =
  'Geode is an open-source, local-first Markdown knowledge base. Your notes remain plain Markdown files on your disk.';
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description || defaultDescription} canonicalUrl={canonicalUrl} ogImage={ogImage} />
  </head>
  <body class:list={['bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] antialiased', { 'landing-page': landing }]}>
    {!landing && <Nav />}
    {landing && <slot name="header" />}
    <main class:list={{ 'landing-main': landing }}>
      <slot />
    </main>
    {landing && <slot name="footer" />}
    {!landing && <Footer />}
  </body>
</html>
