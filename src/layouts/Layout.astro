---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const defaultDescription =
  'Geode is an open-source, local-first Markdown knowledge base — a clean-room clone of Obsidian. Your notes stay plain Markdown files on your disk. No account, no cloud, no lock-in.';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description || defaultDescription} canonicalUrl={canonicalUrl} ogImage={ogImage} />
  </head>
  <body class="bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
