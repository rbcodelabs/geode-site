---
import Layout from './Layout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import { getCollection } from 'astro:content';
import { sortDocs } from '../lib/docsCategories';

interface Props {
  title: string;
  description: string;
  currentId: string;
}

const { title, description, currentId } = Astro.props;

const allDocs = await getCollection('docs');
const sorted = sortDocs(allDocs);

const currentIndex = sorted.findIndex((d) => d.id === currentId);
const prevDoc = currentIndex > 0 ? sorted[currentIndex - 1] : null;
const nextDoc = currentIndex >= 0 && currentIndex < sorted.length - 1 ? sorted[currentIndex + 1] : null;
---

<Layout title={`${title} — Geode Docs`} description={description}>
  <div class="docs-layout">
    <DocsSidebar docs={sorted} currentId={currentId} />

    <div class="docs-article-column">
      <article class="docs-content">
        <header class="docs-article-header">
          <div class="docs-kicker">Geode documentation</div>
          <h1>{title}</h1>
          <p>{description}</p>
        </header>
        <div class="docs-article-body">
          <slot />
        </div>
      </article>

      <nav class="docs-page-nav" aria-label="Page navigation">
        {
          prevDoc ? (
            <a href={`/docs/${prevDoc.id}/`} class="card">
              <span>← Previous</span>
              <strong>{prevDoc.data.title}</strong>
            </a>
          ) : <span />
        }
        {
          nextDoc ? (
            <a href={`/docs/${nextDoc.id}/`} class="card is-next">
              <span>Next →</span>
              <strong>{nextDoc.data.title}</strong>
            </a>
          ) : <span />
        }
      </nav>
    </div>
  </div>
</Layout>
